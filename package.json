{
  "name": "nil-config-catcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "python3 -m unittest discover -s tests -v",
    "test:e2e": "playwright test",
    "collect": "python3 -m collector",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "build:hosted": "tsc --noEmit && vite build --mode hosted && node scripts/generate-sw.mjs dist-hosted",
    "test:hosted-ui": "playwright test --config playwright.hosted.config.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icons": "node scripts/desktop-icons.mjs",
    "icons": "node scripts/generate-icons.mjs && node scripts/desktop-icons.mjs",
    "test:installer": "python3 -m unittest discover -s tests -p 'test_installer.py' -v",
    "test:desktop-ui": "playwright test --config playwright.desktop.config.ts",
    "test:service": "tsc -p service/tsconfig.json && node --experimental-strip-types --test service/tests/service.test.ts",
    "package:runtime": "npm run build:hosted && python3 scripts/package-runtime.py"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.2.8",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-opener": "2.7.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.12.4",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
